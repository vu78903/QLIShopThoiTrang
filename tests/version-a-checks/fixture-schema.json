  "views": [
    {
      "name": "sanphamkhuyenmai_hientai",
      "definition": " WITH muc_giam AS (\n         SELECT DISTINCT ON (ksp.masku) ksp.masku,\n            ksp.makm,\n            ksp.phantramgiam,\n            km.ngaybatdau,\n            km.ngayketthuc\n           FROM khuyenmaisanpham ksp\n             JOIN khuyenmai km ON km.makm::text = ksp.makm::text\n          WHERE km.trangthai = true AND (CURRENT_TIMESTAMP AT TIME ZONE 'Asia/Ho_Chi_Minh'::text) >= km.ngaybatdau AND (CURRENT_TIMESTAMP AT TIME ZONE 'Asia/Ho_Chi_Minh'::text) <= km.ngayketthuc\n          ORDER BY ksp.masku, ksp.phantramgiam DESC, ksp.makm\n        )\n SELECT mg.makm AS makhuyenmai,\n    sp.masp AS masanpham,\n    sp.masku,\n    sp.tensanpham,\n    sp.mausac,\n    sp.kichco,\n    sp.dongia AS giagoc,\n    mg.phantramgiam,\n    round(sp.dongia * (100::numeric - mg.phantramgiam) / 100::numeric, 0) AS giakhuyenmai,\n    mg.ngaybatdau,\n    mg.ngayketthuc,\n    sp.hinhanh\n   FROM muc_giam mg\n     JOIN sanpham sp ON sp.masku::text = mg.masku::text\n  WHERE sp.trangthai = true;"
    }
  ]
}